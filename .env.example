# Required to ingest the public website. Never expose either key to the browser.
FIRECRAWL_API_KEY=
# Free LLM Provider option: Groq (Get free API key at https://console.groq.com)
# LLM_PROVIDER=groq
# GROQ_API_KEY=gsk_...
# LLM_MODEL=llama-3.3-70b-versatile

# Default provider setup (xAI Grok)
LLM_PROVIDER=xai
LLM_MODEL=grok-3-mini
XAI_API_KEY=

# For any other custom OpenAI-compatible provider (e.g. Mistral)
LLM_BASE_URL=
LLM_API_KEY=

ALLOWED_ORIGINS=https://globaldigitalnexus.com,https://www.globaldigitalnexus.com,http://localhost:8080
RATE_LIMIT=20/minute
REDIS_URL=redis://localhost:6379/0
CHROMA_PERSIST_DIRECTORY=data/chroma
COLLECTION_NAME=gdn_website
RETRIEVAL_K=5

# Optional LangSmith Tracing & Observability
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=gdn-chatbot


