# Required to ingest the public website. Never expose either key to the browser.
FIRECRAWL_API_KEY=
XAI_API_KEY=

# The provider abstraction also supports any OpenAI-compatible service.
LLM_PROVIDER=xai
LLM_MODEL=grok-3-mini
# For a provider other than xAI, set both values below.
LLM_BASE_URL=
LLM_API_KEY=

ALLOWED_ORIGINS=https://globaldigitalnexus.com,https://www.globaldigitalnexus.com,http://localhost:8080
RATE_LIMIT=20/minute
REDIS_URL=redis://localhost:6379/0
CHROMA_PERSIST_DIRECTORY=data/chroma
COLLECTION_NAME=gdn_website
RETRIEVAL_K=5

# Optional LangSmith Tracing & Observability
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=gdn-chatbot


